# Copy to .env.local for local runs.

# Product app URL (app.ypnus.com) — used for SEO metadata, canonical URLs,
# sitemap and robots. Defaults to https://app.ypnus.com.
NEXT_PUBLIC_SITE_URL=https://app.ypnus.com

# Marketing / WordPress site. Used for signup, content, and live territory ledger.
NEXT_PUBLIC_MARKETING_SITE_URL=https://ypnus.com

# WordPress REST base for live ZIP lock ledger + signup APIs.
# Defaults to ${NEXT_PUBLIC_MARKETING_SITE_URL}/wp-json/ypnus/v1
YPNUS_WP_API_BASE=https://ypnus.com/wp-json/ypnus/v1

# Where the JSON data snapshot is written. Defaults to ./data (a persistent Node
# host) — set to a writable path (e.g. /tmp/ypnus) on read-only/serverless hosts.
# NOTE: the store is instance-local (in-memory + this file). On a persistent Node
# host it fully persists; on serverless, state is reliable only within a single
# warm instance and resets on cold start — use a shared database for durable
# production data (see supabase-leads-schema.sql).
LOANPILOT_DATA_DIR=

# POST completed intake payloads here (omit or leave blank to skip).
# Example: https://hooks.zapier.com/hooks/catch/…
INTAKE_EXTERNAL_WEBHOOK_URL=

# Optional demo pacing: compress the multi-day nurture ladder for live demos.
# "1" makes a "day" last two minutes; or set LOANPILOT_DEMO_DAY_MINUTES=<n>.
LOANPILOT_DEMO_DAY_MINUTES=
LOANPILOT_DEMO_MODE=

# Optional: Hostinger API token for deploying/fixing ypnus.com hosting via MCP.
HOSTINGER_API_TOKEN=

# Signs the ypnus_session cookie. Without it, a secret is generated and persisted
# to <data dir>/session-secret.key so a single Node process stays self-consistent —
# fine for local dev, but set this explicitly in production so sessions survive
# redeploys and validate across every instance.
SESSION_SECRET=

# Shared secret for the ypnus.com -> app.ypnus.com SSO handoff (see
# docs/sso-handoff.md). Both hosts must be configured with the same value.
# The handoff endpoint rejects every request until this is set.
YPNUS_SSO_SHARED_SECRET=

# Public origin where the local SEO routes are exposed. This Next.js app runs on
# app.ypnus.com by default, so ypnus.com must reverse-proxy these routes (and the
# local sitemap) before using the marketing origin in production.
LOCAL_SEO_PUBLIC_ORIGIN=https://ypnus.com

# Co-branded public mortgage-professional profile. Publish a street address only
# when it is accurate and customer-facing; service-area businesses may omit it.
MLO_PUBLIC_NAME=
MLO_PUBLIC_PHONE=
MLO_PUBLIC_EMAIL=
MLO_PUBLIC_STREET_ADDRESS=
MLO_PUBLIC_LOCALITY=
MLO_PUBLIC_REGION=
MLO_PUBLIC_POSTAL_CODE=
MLO_NMLS_ID=

# Verified Google Business Profile references. Place ID powers Google's direct
# review URL; profile URL links visitors to the public listing.
GBP_PLACE_ID=
GBP_PROFILE_URL=

# Optional data providers for the predictive lead-scoring agent
# (src/lib/agents/zipContext.ts, countyEvents.ts). Left unset, these return a
# neutral placeholder so predictiveAgent still gets a well-formed input.
COUNTY_LOOKUP_API_URL=
CENSUS_API_BASE=
CENSUS_API_KEY=
RENTAL_DEMAND_API_URL=
RENTAL_DEMAND_API_TOKEN=
COUNTY_EVENTS_API_URL=
COUNTY_EVENTS_API_TOKEN=

# Optional browser-restricted Maps Embed API key.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Reviews must come from a server-side provider that your organization is
# permitted to use. The provider may return an array or { "reviews": [...] }.
GBP_REVIEWS_PROVIDER_URL=
GBP_REVIEWS_PROVIDER_TOKEN=
# Deployment-only alternative for a small validated feed. Never add real
# customer content to source control.
GBP_VERIFIED_REVIEWS_JSON=

# Machine-to-machine secret for the endpoints that write leads or send outreach
# (POST /api/webhooks/leads, POST /api/automation/process) and for the
# session-gated read APIs (/api/analytics/summary, /api/revenue/summary).
# Callers pass it as `Authorization: Bearer <value>`, `X-Admin-Token`, or
# `X-Cron-Secret`. These endpoints reject every request until one is set.
ADMIN_TOKEN=
CRON_SECRET=

# Closing system -> POST /api/reviews/request -> SMS/email provider webhook.
# A secret is required in production; the delivery webhook receives the
# generated message but YPN USA does not claim that Google sent it.
REVIEW_REQUEST_API_SECRET=
REVIEW_REQUEST_WEBHOOK_URL=
REVIEW_REQUEST_WEBHOOK_TOKEN=
